ASAP2_VERSION 1 61

/begin PROJECT FBH3ID60 "Kia Spectra 1.6 Bosch M7.9.7 FBH3ID60"

  /begin HEADER "Kia Spectra 1.6 Bosch M7.9.7 FBH3ID60"
    VERSION "1.0"
  /end HEADER

  /begin MODULE FBH3ID60_MOD "Bosch M7.9.7 / Infineon C167"

    /begin MOD_COMMON "little-endian, выравнивание 1"
      BYTE_ORDER MSB_LAST
      ALIGNMENT_BYTE 1
      ALIGNMENT_WORD 1
      ALIGNMENT_LONG 1
    /end MOD_COMMON

    /begin COMPU_METHOD CM_IDENTITY
      "без пересчёта (сырые значения)"
      RAT_FUNC "%.3f" ""
      COEFFS 0 1 0 0 0 1
    /end COMPU_METHOD

    /begin RECORD_LAYOUT RL_2D_A8_D8
      NO_AXIS_PTS_X 1 UBYTE
      AXIS_PTS_X    2 UBYTE INDEX_INCR DIRECT
      FNC_VALUES    3 UBYTE ROW_DIR DIRECT
    /end RECORD_LAYOUT

    /begin RECORD_LAYOUT RL_3D_A8_D8
      NO_AXIS_PTS_X 1 UBYTE
      NO_AXIS_PTS_Y 2 UBYTE
      AXIS_PTS_X    3 UBYTE INDEX_INCR DIRECT
      AXIS_PTS_Y    4 UBYTE INDEX_INCR DIRECT
      FNC_VALUES    5 UBYTE ROW_DIR DIRECT
    /end RECORD_LAYOUT

    /begin RECORD_LAYOUT RL_GRID_D8
      FNC_VALUES 1 UBYTE ROW_DIR DIRECT
    /end RECORD_LAYOUT

    /begin RECORD_LAYOUT RL_3D_A8_D16
      NO_AXIS_PTS_X 1 UBYTE
      NO_AXIS_PTS_Y 2 UBYTE
      AXIS_PTS_X    3 UBYTE INDEX_INCR DIRECT
      AXIS_PTS_Y    4 UBYTE INDEX_INCR DIRECT
