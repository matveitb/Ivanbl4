    /begin CHARACTERISTIC SGA08MDUB
      "подтверждена | damos | адрес 0x10067, данные 0x10067 | base point distribution of actual gear 8 b.pt."
      CURVE
      0x10067
      RL_GRID_DU8
      0
      CM_IDENTITY
      0
      255
      /begin AXIS_DESCR FIX_AXIS
        NO_INPUT_QUANTITY
        CM_IDENTITY
        8
        0
        7
        FIX_AXIS_PAR_DIST 0 1 8
      /end AXIS_DESCR
    /end CHARACTERISTIC

